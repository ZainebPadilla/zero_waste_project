<div class="container">
  <br>
  <h1 class="text-center">Actualités Environnementales</h1> <br>
  
  <% if @error_message %>
    <div class="alert alert-danger">
      <%= @error_message %>
    </div>
  <% end %>

  <div class="row">
    <% @articles.each do |article| %>
    <% next unless article['urlToImage'].present? %> <!-- allows only articles with image -->
      <div class="col-md-4">
        <div class="card mb-4">
          <% if article['urlToImage'] %>
            <%= image_tag article['urlToImage'], class: 'card-img-top', alt: 'Image de l\'article' %>
          <% end %>
          <div class="card-body">
            <h5 class="card-title"><%= article['title'] %></h5>
            <p class="card-text"><%= article['description'] %></p>
            <%= link_to 'Lire l\'article', article['url'], target: '_blank', class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
