<%= render "devise/shared/error_messages", resource: resource %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <!-- Card 1: Company Name -->
      <div class="card shadow-sm mb-4">
        <div class="card-header text-center bg-primary text-white">
          <h4>Nom de l'entreprise</h4>
        </div>
        <div class="card-body">
          <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), method: :put, local: true, class: "form") do |f| %>
            <!-- Input field for company name -->
            <div class="form-group">
              <%= f.label :company_name, "Nom de l'entreprise", class: "form-label" %>
              <%= f.text_field :company_name, class: "form-control w-50", placeholder: "Entrez le nom de votre entreprise" %>
            </div>
            <!-- Submit button for company name update -->
            <div class="text-end mt-3">
              <%= f.submit "Mettre à jour", class: "btn btn-primary btn-sm" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Card 2: Email and Password -->
      <div class="card shadow-sm mb-4">
        <div class="card-header text-center bg-success text-white">
          <h4>Email et Mot de Passe</h4>
        </div>
        <div class="card-body">
          <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), method: :put, local: true, class: "form") do |f| %>
            <!-- Input field for email -->
            <div class="form-group mb-3">
              <%= f.label :email, "Adresse e-mail", class: "form-label" %>
              <%= f.email_field :email, class: "form-control w-50", placeholder: "Entrez votre email" %>
            </div>
            
            <!-- Input field for new password -->
            <div class="form-group mb-3">
              <%= f.label :password, "Nouveau mot de passe (facultatif)", class: "form-label" %>
              <%= f.password_field :password, class: "form-control w-50", placeholder: "Nouveau mot de passe" %>
            </div>
            
            <!-- Input field for password confirmation -->
            <div class="form-group mb-3">
              <%= f.label :password_confirmation, "Confirmez le mot de passe", class: "form-label" %>
              <%= f.password_field :password_confirmation, class: "form-control w-50", placeholder: "Confirmez votre mot de passe" %>
            </div>
            
            <!-- Input field for current password -->
            <div class="form-group mb-3">
              <%= f.label :current_password, "Mot de passe actuel", class: "form-label" %>
              <%= f.password_field :current_password, class: "form-control w-50", placeholder: "Entrez votre mot de passe actuel" %>
            </div>
            
            <!-- Submit button for email and password update -->
            <div class="text-end mt-3">
              <%= f.submit "Mettre à jour", class: "btn btn-success btn-sm" %>
            </div>
          <% end %>
        </div>
      </div>

     <!-- Card 3: Account Deletion (Ensuring Yellow/Orange Color) -->
      <div class="card shadow-sm mb-4 ">
        <div class="card-header text-center bg-warning text-dark">
          <h4>Suppression de compte</h4>
        </div>
        <div class="card-body">
          <%= form_with url: registration_path(resource_name), method: :delete do |f| %>
            <!-- Input field for current password required to delete the account -->
            <div class="form-group mb-3">
              <%= f.label :current_password, "Mot de passe actuel", class: "form-label" %>
              <%= f.password_field :current_password, class: "form-control w-50", placeholder: "Entrez votre mot de passe actuel" %>
            </div>
            <!-- Submit button for account deletion -->
            <div class="text-end mt-3">
              <%= f.submit "Supprimer mon compte", 
                          data: { confirm: "Êtes-vous sûr ? Cette action est irréversible." }, 
                          class: "btn btn-warning btn-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
